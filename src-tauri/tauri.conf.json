{
  "$schema": "https://schema.tauri.app/config/2.json",
  "productName": "OpenPhotobooth",
  "version": "1.0.0",
  "identifier": "io.openphotobooth",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenPhotobooth",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src http://localhost:5513"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
