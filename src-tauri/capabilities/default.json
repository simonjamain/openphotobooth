{
  "$schema": "../node_modules/@tauri-apps/cli/schema/acl/schemas/capability.schema.json",
  "identifier": "default",
  "description": "Default application capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "fs:allow-copy-file",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$APPDATA/**" },
        { "path": "$LOCALAPPDATA/**" }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$APPDATA/**" },
        { "path": "$LOCALAPPDATA/**" }
      ]
    }
  ]
}
