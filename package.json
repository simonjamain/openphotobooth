{
  "name": "openphotobooth",
  "version": "1.0.0",
  "description": "Open-source photobooth software for use with tethering and auto-printing apps.",
  "main": "dist/main/index.js",
  "scripts": {
    "start": "npm run build && electron .",
    "build": "tsc && node scripts/copy-assets.js",
    "dist": "npm run build && electron-builder",
    "test": "jest"
  },
  "keywords": ["photobooth", "electron", "digicamcontrol"],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "io.openphotobooth",
    "productName": "OpenPhotobooth",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
