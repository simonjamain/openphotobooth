  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/path-browserify": "^1.0.3",
    "path-browserify": "^1.0.1",
    "typescript": "^5.8.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
